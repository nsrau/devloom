{
  "$schema": "https://opencode.ai/theme.json",
  "name": "DevLoom Night Owl",
  "author": "DevLoom",
  "defs": {
    "owlBg": "#011627",
    "owlBgPanel": "#0a1f2e",
    "owlBgElement": "#0f2a3d",
    "owlBgHover": "#15344a",
    "owlBgSelection": "#1d3b52",
    "owlFg": "#d6deeb",
    "owlFgMuted": "#607e99",
    "owlFgDim": "#3a6075",
    "owlBorder": "#1b3b4f",
    "owlBorderActive": "#7fdbca",
    "owlCyan": "#7fdbca",
    "owlTeal": "#5f7e97",
    "owlOrange": "#f78c6c",
    "owlYellow": "#ecc48d",
    "owlGreen": "#addb67",
    "owlRed": "#ff5874",
    "owlPurple": "#c792ea",
    "owlBlue": "#82aaff",
    "owlPink": "#f07178",
    "owlDiffAdd": "#1a3a2a",
    "owlDiffRemove": "#3a1520",
    "owlHighlightAdd": "#2d5a3d",
    "owlHighlightRemove": "#5a2030"
  },
  "theme": {
    "primary": { "dark": "owlCyan", "light": "owlTeal" },
    "secondary": { "dark": "owlTeal", "light": "owlBlue" },
    "accent": { "dark": "owlPurple", "light": "owlPink" },
    "error": { "dark": "owlRed", "light": "owlRed" },
    "warning": { "dark": "owlOrange", "light": "owlOrange" },
    "success": { "dark": "owlGreen", "light": "owlGreen" },
    "info": { "dark": "owlBlue", "light": "owlBlue" },
    "text": { "dark": "owlFg", "light": "owlBg" },
    "textMuted": { "dark": "owlFgMuted", "light": "owlFgMuted" },
    "background": { "dark": "owlBg", "light": "#f0f4f8" },
    "backgroundPanel": { "dark": "owlBgPanel", "light": "#e2e8f0" },
    "backgroundElement": { "dark": "owlBgElement", "light": "#cbd5e1" },
    "backgroundHover": { "dark": "owlBgHover", "light": "#b0c4de" },
    "backgroundSelection": { "dark": "owlBgSelection", "light": "#94a3b8" },
    "border": { "dark": "owlBorder", "light": "#94a3b8" },
    "borderActive": { "dark": "owlBorderActive", "light": "owlCyan" },
    "borderSubtle": { "dark": "owlBgSelection", "light": "#cbd5e1" },
    "diffAdded": { "dark": "owlGreen", "light": "owlGreen" },
    "diffRemoved": { "dark": "owlRed", "light": "owlRed" },
    "diffContext": { "dark": "owlFgMuted", "light": "owlFgMuted" },
    "diffHunkHeader": { "dark": "owlTeal", "light": "owlTeal" },
    "diffHighlightAdded": { "dark": "owlGreen", "light": "owlGreen" },
    "diffHighlightRemoved": { "dark": "owlRed", "light": "owlRed" },
    "diffAddedBg": { "dark": "owlDiffAdd", "light": "#dcfce7" },
    "diffRemovedBg": { "dark": "owlDiffRemove", "light": "#fee2e2" },
    "diffContextBg": { "dark": "owlBgPanel", "light": "#f1f5f9" },
    "diffLineNumber": { "dark": "owlFgDim", "light": "#94a3b8" },
    "diffAddedLineNumberBg": { "dark": "owlDiffAdd", "light": "#dcfce7" },
    "diffRemovedLineNumberBg": { "dark": "owlDiffRemove", "light": "#fee2e2" },
    "markdownText": { "dark": "owlFg", "light": "#1e293b" },
    "markdownHeading": { "dark": "owlCyan", "light": "owlTeal" },
    "markdownLink": { "dark": "owlBlue", "light": "owlBlue" },
    "markdownLinkText": { "dark": "owlCyan", "light": "owlCyan" },
    "markdownCode": { "dark": "owlGreen", "light": "owlGreen" },
    "markdownBlockQuote": { "dark": "owlFgDim", "light": "#94a3b8" },
    "markdownEmph": { "dark": "owlOrange", "light": "owlOrange" },
    "markdownStrong": { "dark": "owlYellow", "light": "owlYellow" },
    "markdownHorizontalRule": { "dark": "owlBorder", "light": "#94a3b8" },
    "markdownListItem": { "dark": "owlCyan", "light": "owlTeal" },
    "markdownListEnumeration": { "dark": "owlOrange", "light": "owlOrange" },
    "markdownImage": { "dark": "owlPurple", "light": "owlPurple" },
    "markdownImageText": { "dark": "owlPink", "light": "owlPink" },
    "markdownCodeBlock": { "dark": "owlFg", "light": "owlBg" },
    "syntaxComment": { "dark": "owlFgDim", "light": "#94a3b8" },
    "syntaxKeyword": { "dark": "owlPurple", "light": "owlPurple" },
    "syntaxFunction": { "dark": "owlCyan", "light": "owlTeal" },
    "syntaxVariable": { "dark": "owlOrange", "light": "owlOrange" },
    "syntaxString": { "dark": "owlGreen", "light": "owlGreen" },
    "syntaxNumber": { "dark": "owlYellow", "light": "owlYellow" },
    "syntaxType": { "dark": "owlBlue", "light": "owlBlue" },
    "syntaxOperator": { "dark": "owlPink", "light": "owlPink" },
    "syntaxPunctuation": { "dark": "owlFg", "light": "#1e293b" },
    "syntaxConstant": { "dark": "owlPurple", "light": "owlPurple" },
    "syntaxBuiltin": { "dark": "owlCyan", "light": "owlTeal" },
    "syntaxProperty": { "dark": "owlBlue", "light": "owlBlue" },
    "syntaxMethod": { "dark": "owlCyan", "light": "owlTeal" },
    "syntaxTag": { "dark": "owlRed", "light": "owlRed" },
    "syntaxAttribute": { "dark": "owlOrange", "light": "owlOrange" },
    "syntaxRegexp": { "dark": "owlPink", "light": "owlPink" },
    "syntaxNamespace": { "dark": "owlYellow", "light": "owlYellow" },
    "syntaxParameter": { "dark": "owlOrange", "light": "owlOrange" },
    "syntaxField": { "dark": "owlBlue", "light": "owlBlue" },
    "syntaxBoolean": { "dark": "owlPurple", "light": "owlPurple" },
    "syntaxSpecial": { "dark": "owlPink", "light": "owlPink" },
    "syntaxEscapeChar": { "dark": "owlPink", "light": "owlPink" },
    "syntaxLabel": { "dark": "owlPurple", "light": "owlPurple" },
    "syntaxImport": { "dark": "owlCyan", "light": "owlTeal" },
    "syntaxPreproc": { "dark": "owlOrange", "light": "owlOrange" },
    "syntaxDiffPlus": { "dark": "owlGreen", "light": "owlGreen" },
    "syntaxDiffMinus": { "dark": "owlRed", "light": "owlRed" },
    "syntaxDiffLine": { "dark": "owlBlue", "light": "owlBlue" }
  }
}
